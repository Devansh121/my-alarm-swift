<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Alarm</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Alarm uses Bluetooth to sync your alarms with your Garmin watch.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Alarm uses Bluetooth to sync your alarms with your Garmin watch.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>gcm-ciq</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.devansh.alarmclock</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>alarmclock</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.devansh.alarmclock.connectiq</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>alarmclock-ciq</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
